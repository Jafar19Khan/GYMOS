{
  "name": "gymos",
  "version": "0.2.0",
  "private": true,
  "description": "Premium gym website and gym operations platform",
  "engines": {
    "node": ">=20.19.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "^4.1.17",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.1.17",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.4.2",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@eslint/eslintrc": "^3.3.1"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
