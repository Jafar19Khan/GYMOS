generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum MembershipStatus {
  UPCOMING
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
}

enum PaymentType {
  CHARGE
  REFUND
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum AttendanceMethod {
  MANUAL
  QR
}

enum BookingStatus {
  BOOKED
  WAITLISTED
  CANCELLED
  ATTENDED
}

model Gym {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  timezone    String   @default("Asia/Kolkata")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  memberProfiles MemberProfile[]
  plans        MembershipPlan[]
  memberships  Membership[]
  attendances  Attendance[]
  classes      GymClass[]
  bookings     ClassBooking[]
  payments     Payment[]
  permissions  StaffPermission[]
  auditLogs    AuditLog[]
  invitations  AccountInvitation[]

  @@map("gyms")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  gymId        String?    @db.Uuid
  isGymOwner   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  gym                Gym?              @relation(fields: [gymId], references: [id], onDelete: Restrict)
  memberProfile      MemberProfile?
  sessions           Session[]
  permissions        StaffPermission[]
  memberships        Membership[]      @relation("MembershipMember")
  attendances        Attendance[]      @relation("AttendanceMember")
  createdAttendances Attendance[]      @relation("AttendanceActor")
  coachedClasses     GymClass[]        @relation("ClassCoach")
  bookings           ClassBooking[]    @relation("BookingMember")
  receivedPayments   Payment[]         @relation("PaymentMember")
  createdPayments    Payment[]         @relation("PaymentCreator")
  auditLogs          AuditLog[]        @relation("AuditActor")
  receivedInvitations AccountInvitation[] @relation("InvitationRecipient")
  createdInvitations  AccountInvitation[] @relation("InvitationCreator")

  @@index([gymId, role, status])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model MemberProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  gymId                 String   @db.Uuid
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  dateOfBirth           DateTime?
  healthDataConsent     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@map("member_profiles")
}

model StaffPermission {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  gymId      String   @db.Uuid
  permission String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Restrict)

  @@unique([userId, gymId, permission])
  @@index([gymId, permission])
  @@map("staff_permissions")
}

model MembershipPlan {
  id           String   @id @default(uuid()) @db.Uuid
  gymId        String   @db.Uuid
  name         String
  description  String?
  durationDays Int
  pricePaise   Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gym          Gym          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  memberships  Membership[]

  @@unique([gymId, name])
  @@index([gymId, isActive])
  @@map("membership_plans")
}

model Membership {
  id         String           @id @default(uuid()) @db.Uuid
  gymId      String           @db.Uuid
  memberId   String           @db.Uuid
  planId     String           @db.Uuid
  status     MembershipStatus @default(UPCOMING)
  startDate  DateTime
  endDate    DateTime
  frozenFrom DateTime?
  frozenTo   DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  gym     Gym            @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member  User           @relation("MembershipMember", fields: [memberId], references: [id], onDelete: Restrict)
  plan    MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([gymId, status, endDate])
  @@index([memberId, status])
  @@map("memberships")
}

model Attendance {
  id               String           @id @default(uuid()) @db.Uuid
  gymId            String           @db.Uuid
  memberId         String           @db.Uuid
  recordedById     String?          @db.Uuid
  method           AttendanceMethod @default(MANUAL)
  idempotencyKey   String?          @unique
  checkedInAt      DateTime         @default(now())
  note             String?

  gym        Gym  @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member     User @relation("AttendanceMember", fields: [memberId], references: [id], onDelete: Restrict)
  recordedBy User? @relation("AttendanceActor", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([gymId, checkedInAt])
  @@index([memberId, checkedInAt])
  @@map("attendances")
}

model GymClass {
  id          String   @id @default(uuid()) @db.Uuid
  gymId       String   @db.Uuid
  name        String
  description String?
  coachId     String?  @db.Uuid
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym      Gym            @relation(fields: [gymId], references: [id], onDelete: Restrict)
  coach    User?          @relation("ClassCoach", fields: [coachId], references: [id], onDelete: SetNull)
  bookings ClassBooking[]

  @@index([gymId, startsAt])
  @@map("gym_classes")
}

model ClassBooking {
  id        String        @id @default(uuid()) @db.Uuid
  gymId     String        @db.Uuid
  classId   String        @db.Uuid
  memberId  String        @db.Uuid
  status    BookingStatus @default(WAITLISTED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  gym    Gym      @relation(fields: [gymId], references: [id], onDelete: Restrict)
  gymClass GymClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  member User     @relation("BookingMember", fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([classId, memberId])
  @@index([classId, status, createdAt, id])
  @@index([memberId, status])
  @@map("class_bookings")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  gymId          String        @db.Uuid
  memberId       String        @db.Uuid
  createdById    String        @db.Uuid
  type           PaymentType
  method         PaymentMethod
  amountPaise    Int
  currency       String        @default("INR")
  reference      String?
  note           String?
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())

  gym       Gym  @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member    User @relation("PaymentMember", fields: [memberId], references: [id], onDelete: Restrict)
  createdBy User @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([gymId, createdAt])
  @@index([memberId, createdAt])
  @@map("payments")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  gymId        String?  @db.Uuid
  actorId      String?  @db.Uuid
  event        String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  gym   Gym?  @relation(fields: [gymId], references: [id], onDelete: SetNull)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([gymId, createdAt])
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}


model AccountInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  gymId       String    @db.Uuid
  createdById String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user      User @relation("InvitationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  gym       Gym  @relation(fields: [gymId], references: [id], onDelete: Restrict)
  createdBy User @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([gymId, createdAt])
  @@map("account_invitations")
}
