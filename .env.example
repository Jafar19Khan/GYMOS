NODE_ENV=development
APP_URL=http://localhost:3000
# QR attendance signing secret; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATTENDANCE_QR_SECRET=replace-with-at-least-32-random-bytes
NEXT_TELEMETRY_DISABLED=1
POSTGRES_DB=gymos
POSTGRES_USER=gymos
POSTGRES_PASSWORD=change-this-local-password
# Host-side URL for Prisma CLI and local development.
DATABASE_URL=postgresql://gymos:change-this-local-password@localhost:5432/gymos?schema=public
# Docker-internal URL used by the web container. Keep the password in sync.
DATABASE_URL_DOCKER=postgresql://gymos:change-this-local-password@db:5432/gymos?schema=public

# Optional one-time bootstrap accounts. Use unique, strong local-only values.
BOOTSTRAP_GYM_NAME=GYMOS Demo Gym
BOOTSTRAP_OWNER_NAME=Gym Owner
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_NAME=Platform Admin
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
